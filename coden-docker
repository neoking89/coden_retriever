#!/bin/bash
# Wrapper script to run coden-retriever in Docker like a native CLI
# Uses a persistent container with bind mount for fast repeated queries
#
# Usage:
#   ./coden-docker start [path]    # Start container (mounts path, default: current dir)
#   ./coden-docker stop            # Stop the container
#   ./coden-docker .               # Run coden commands
#   ./coden-docker -a              # Agent mode

set -euo pipefail

# Disable Git Bash path conversion (Windows-specific)
export MSYS_NO_PATHCONV=1

CONTAINER_NAME="${CODEN_CONTAINER_NAME:-coden-persistent}"
IMAGE_NAME="${CODEN_IMAGE_NAME:-coden-retriever:latest}"

# Colors for output (disabled if not a terminal)
if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    NC='\033[0m' # No Color
else
    RED=''
    GREEN=''
    YELLOW=''
    NC=''
fi

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*" >&2; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# Detect platform
IS_WINDOWS=false
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "mingw"* || "$OSTYPE" == "cygwin" ]]; then
    IS_WINDOWS=true
fi

# Cleanup function for graceful exit
cleanup() {
    local exit_code=$?
    # Only log if we're exiting due to an error (not Ctrl+C or normal exit)
    if [[ $exit_code -ne 0 && $exit_code -ne 130 ]]; then
        log_error "Script exited with code $exit_code"
    fi
    exit $exit_code
}

# Set trap for cleanup on exit
trap cleanup EXIT

# Check if Docker is available
check_docker() {
    if ! command -v docker &>/dev/null; then
        log_error "Docker is not installed or not in PATH"
        exit 1
    fi
    if ! docker info &>/dev/null; then
        log_error "Docker daemon is not running"
        exit 1
    fi
}

# Check if image exists
check_image() {
    if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
        log_error "Image '$IMAGE_NAME' not found. Build it first with:"
        log_error "  docker build -t $IMAGE_NAME ."
        exit 1
    fi
}

# Convert path to Docker-compatible format
get_docker_path() {
    local path="$1"

    # Validate path exists
    if [[ ! -d "$path" ]]; then
        log_error "Directory does not exist: $path"
        exit 1
    fi

    if $IS_WINDOWS; then
        # Windows Git Bash - get Windows path
        (cd "$path" 2>/dev/null && pwd -W) || echo "$path"
    else
        (cd "$path" 2>/dev/null && pwd) || echo "$path"
    fi
}

# Check if container is running
is_running() {
    docker ps --filter "name=^${CONTAINER_NAME}$" --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"
}

# Check if container exists
container_exists() {
    docker ps -a --filter "name=^${CONTAINER_NAME}$" --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"
}

# Wait for container to accept exec commands
wait_for_container_ready() {
    local retries=10
    local delay=0.5

    while [[ $retries -gt 0 ]]; do
        if docker exec "$CONTAINER_NAME" true &>/dev/null 2>&1; then
            return 0
        fi
        sleep "$delay"
        retries=$((retries - 1))
    done
    return 1
}

# Start the persistent container with workspace bind mount
start_container() {
    local mount_path="${1:-$(pwd)}"

    check_docker
    check_image

    mount_path=$(get_docker_path "$mount_path")

    if is_running; then
        local current_workspace
        current_workspace=$(docker inspect "$CONTAINER_NAME" --format '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' 2>/dev/null || echo "unknown")
        log_info "Container '$CONTAINER_NAME' is already running."
        log_info "Workspace: $current_workspace"
        echo ""
        echo "To change workspace, run: ./coden-docker restart [new-path]"
        return 0
    fi

    # Remove existing stopped container
    if container_exists; then
        docker rm "$CONTAINER_NAME" >/dev/null 2>&1 || true
    fi

    log_info "Starting container with workspace: $mount_path"

    if ! docker run -d \
        --name "$CONTAINER_NAME" \
        -v "${mount_path}:/workspace:ro" \
        -v coden-retriever-cache:/home/coden/.coden-retriever \
        -v coden-retriever-config:/home/coden/.coden-retriever \
        -w /workspace \
        --add-host=host.docker.internal:host-gateway \
        -e OLLAMA_HOST=http://host.docker.internal:11434 \
        --security-opt no-new-privileges:true \
        --entrypoint "tail" \
        "$IMAGE_NAME" \
        -f /dev/null >/dev/null; then
        log_error "Failed to start container"
        exit 1
    fi

    # Wait for container to be ready for exec commands
    if ! wait_for_container_ready; then
        log_error "Container failed to become ready for commands"
        docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
        exit 1
    fi

    log_info "Container ready!"

    # Clean up stale daemon PID file
    docker exec "$CONTAINER_NAME" rm -f /home/coden/.coden-retriever/daemon.pid 2>/dev/null || true

    # Start daemon synchronously to catch any startup errors
    log_info "Starting daemon for faster queries..."
    if ! docker exec "$CONTAINER_NAME" coden daemon start 2>&1; then
        log_warn "Daemon failed to start (queries will still work, but slower)"
    fi

    return 0
}

# Stop the container
stop_container() {
    check_docker

    if is_running; then
        log_info "Stopping container..."
        docker stop "$CONTAINER_NAME" >/dev/null 2>&1 || true
        docker rm "$CONTAINER_NAME" >/dev/null 2>&1 || true
        log_info "Stopped."
    else
        log_warn "Container is not running."
        # Clean up any stopped container with the same name
        docker rm "$CONTAINER_NAME" >/dev/null 2>&1 || true
    fi
}

# Execute coden command in the container
run_coden() {
    check_docker
    check_image

    # Auto-start container if not running
    if ! is_running; then
        log_warn "Container not running. Starting with current directory..."
        start_container "$(pwd)"
    fi

    # Check if we need interactive mode (agent mode)
    local needs_tty=""
    for arg in "$@"; do
        if [[ "$arg" == "-a" || "$arg" == "--agent" || "$arg" == "agent" ]]; then
            needs_tty="-it"
            break
        fi
    done

    # Execute in container
    # shellcheck disable=SC2086
    if $IS_WINDOWS && [[ -n "$needs_tty" ]]; then
        # Windows Git Bash needs winpty for interactive sessions
        winpty docker exec $needs_tty "$CONTAINER_NAME" coden "$@"
    else
        docker exec $needs_tty "$CONTAINER_NAME" coden "$@"
    fi
}

# Show status
show_status() {
    check_docker

    if is_running; then
        local workspace
        workspace=$(docker inspect "$CONTAINER_NAME" --format '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' 2>/dev/null || echo "unknown")
        log_info "Container '$CONTAINER_NAME' is running."
        log_info "Workspace: $workspace"

        # Show daemon status
        if docker exec "$CONTAINER_NAME" coden daemon status 2>/dev/null; then
            :
        else
            log_warn "Daemon is not running"
        fi
    else
        log_warn "Container is not running."
    fi
}

# Show help
show_help() {
    cat << 'EOF'
coden-docker - Run coden-retriever in a persistent Docker container

Container management:
  start [path]   Start container (mounts path as workspace, default: cwd)
  stop           Stop the container
  restart [path] Restart with new workspace
  status         Show container status

Coden commands (auto-starts if needed):
  .                    Analyze workspace
  . --query "auth"     Search for code
  . --find "MyClass"   Find symbol
  -a                   Agent mode (interactive)

Example workflow:
  cd /your/project
  ./coden-docker start .
  ./coden-docker .              # Fast! (~0.8s cached)
  ./coden-docker . --query x    # Fast!
  ./coden-docker stop

Environment:
  CODEN_IMAGE_NAME     Docker image to use (default: coden-retriever:latest)
  CODEN_CONTAINER_NAME Container name (default: coden-persistent)
EOF
}

# Main command handling
case "${1:-}" in
    start)
        start_container "${2:-$(pwd)}"
        ;;
    stop)
        stop_container
        ;;
    restart)
        stop_container
        sleep 1
        start_container "${2:-$(pwd)}"
        ;;
    status)
        show_status
        ;;
    -h|--help|help)
        show_help
        ;;
    "")
        log_error "No command provided. Use --help for usage."
        exit 1
        ;;
    *)
        run_coden "$@"
        ;;
esac
